<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>Handum Academy</title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <h1>Handum Academy</h1>

  {# Loop over all posts, newest first #}
  {% for post in collections.posts | reverse %}
    <article>
      <h2><a href="{{ post.url }}">{{ post.data.title }}</a></h2>

      {# Nunjucks date filter uses parentheses, not a colon #}
      <time datetime="{{ post.date | date("%Y-%m-%d") }}">
        {{ post.date | date("MMMM D, YYYY") }}
      </time>

      {{ post.templateContent | safe }}
    </article>
  {% else %}
    <p>No updates yet. ETA in <6months</p>
  {% endfor %}
</body>
</html>
